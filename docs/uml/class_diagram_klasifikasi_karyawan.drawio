        <mxCell id="notes" value="&lt;b&gt;KETERANGAN KELAS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;User&lt;/b&gt;: data akun dan login. Diwarisi oleh Admin, HRD, Pimpinan.&lt;br&gt;&lt;b&gt;Admin&lt;/b&gt;: mengelola data karyawan dan data latih.&lt;br&gt;&lt;b&gt;HRD&lt;/b&gt;: menjalankan klasifikasi dan melihat hasil.&lt;br&gt;&lt;b&gt;Pimpinan&lt;/b&gt;: melihat hasil dan mencetak laporan.&lt;br&gt;&lt;b&gt;Karyawan&lt;/b&gt;: data karyawan yang dinilai.&lt;br&gt;&lt;b&gt;DataLatih&lt;/b&gt;: data historis beserta label kelayakan.&lt;br&gt;&lt;b&gt;NaiveBayes&lt;/b&gt;: menghitung prior, likelihood, posterior, menentukan kelas, dan akurasi.&lt;br&gt;&lt;b&gt;HasilKlasifikasi&lt;/b&gt;: menyimpan probabilitas dan kelas Layak / Tidak Layak.&lt;br&gt;&lt;b&gt;Laporan&lt;/b&gt;: rekap hasil untuk dicetak." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;strokeWidth=2;verticalAlign=top;align=left;fontSize=11;fontColor=#1F4E79;arcSize=4;shadow=1;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1330" y="500" width="240" height="400" as="geometry"/>
        </mxCell>
