        <mxCell id="aktorbox" value="&lt;b&gt;KETERANGAN AKTOR&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Admin&lt;/b&gt;: mengelola data karyawan dan data latih.&lt;br&gt;&lt;b&gt;HRD&lt;/b&gt;: menjalankan proses klasifikasi dan melihat hasilnya.&lt;br&gt;&lt;b&gt;Pimpinan&lt;/b&gt;: melihat hasil klasifikasi dan mencetak laporan.&lt;br&gt;&lt;br&gt;Semua aktor wajib melakukan Login terlebih dahulu." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;strokeWidth=2;verticalAlign=top;align=left;fontSize=11;fontColor=#1F4E79;arcSize=4;shadow=1;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1">
