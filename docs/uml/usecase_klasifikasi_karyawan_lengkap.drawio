        </mxCell>

        <mxCell id="ucbox" value="&lt;b&gt;KETERANGAN USE CASE&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Login&lt;/b&gt;: verifikasi username dan password pengguna.&lt;br&gt;&lt;b&gt;Kelola data karyawan&lt;/b&gt;: mengelola data karyawan, input divalidasi terlebih dahulu.&lt;br&gt;&lt;b&gt;Kelola data latih&lt;/b&gt;: data historis sebagai dasar perhitungan Naive Bayes.&lt;br&gt;&lt;b&gt;Proses klasifikasi&lt;/b&gt;: hitung prior, likelihood, dan posterior, lalu tentukan kelas Layak atau Tidak Layak.&lt;br&gt;&lt;b&gt;Lihat hasil&lt;/b&gt;: menampilkan hasil klasifikasi, dapat dicetak sebagai laporan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;strokeWidth=2;verticalAlign=top;align=left;fontSize=11;fontColor=#1F4E79;arcSize=4;shadow=1;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1">
