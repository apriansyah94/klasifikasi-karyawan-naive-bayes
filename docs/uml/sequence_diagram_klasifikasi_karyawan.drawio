        <mxCell id="notes" value="&lt;b&gt;KETERANGAN&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Simbol&lt;/b&gt;&lt;br&gt;Panah penuh: pesan / permintaan.&lt;br&gt;Panah putus-putus: balasan (return).&lt;br&gt;Panah melingkar: proses internal objek.&lt;br&gt;alt: percabangan (salah satu jalur).&lt;br&gt;opt: bagian opsional.&lt;br&gt;&lt;br&gt;&lt;b&gt;Objek&lt;/b&gt;&lt;br&gt;&lt;b&gt;Pengguna (HRD)&lt;/b&gt;: aktor yang menjalankan klasifikasi.&lt;br&gt;&lt;b&gt;Halaman Web&lt;/b&gt;: antarmuka (form dan tampilan hasil).&lt;br&gt;&lt;b&gt;Controller&lt;/b&gt;: pengatur alur dan validasi.&lt;br&gt;&lt;b&gt;Model Naive Bayes&lt;/b&gt;: perhitungan prior, likelihood, posterior.&lt;br&gt;&lt;b&gt;Database&lt;/b&gt;: menyimpan akun, data latih, dan hasil." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2E75B6;strokeWidth=2;verticalAlign=top;align=left;fontSize=11;fontColor=#1F4E79;arcSize=3;shadow=1;spacingLeft=12;spacingRight=10;spacingTop=8;" vertex="1" parent="1">
